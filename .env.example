APP_NAME=ReserveWorx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt

LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reserveworx
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_WORK_MAX_TIME=20

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production lists app.reserveworx.com only. Local development may add localhost.
PLATFORM_DOMAINS=app.reserveworx.com

# Public signup addresses are {slug}.{apex}. Do not point this at the platform host.
BOOKING_APEX=reserveworx.com

# Empty until a platform Stripe secret exists. Online checkout returns 409 until both
# STRIPE_SECRET and STRIPE_WEBHOOK_SECRET are set. The API version is pinned in
# App\Domain\Payments\ConnectAccountSpec, not in this file.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Marketplace OAuth is not used. A platform administrator links each workspace to one
# BrandWorx sub-account. The Private Integration Token is stored encrypted and is not
# put in this file. GHL_VERSION defaults to 2021-07-28.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_VERSION=2021-07-28

# Postmark is a proposal awaiting product-owner approval. Do not install the mailer until then.
# POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
